<?xml version="1.0"?>
<package format="3">
  <name>hazard_guard_mission_manager</name>
  <version>0.1.0</version>
  <description>Ordered waypoint patrol mission manager for HazardGuard and Nav2.</description>
  <maintainer email="gw010101@naver.com">kohs2k21</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>hazard_guard_interfaces</depend>
  <depend>nav2_msgs</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
