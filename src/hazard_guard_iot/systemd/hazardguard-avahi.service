<?xml version="1.0" standalone="no"?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">HazardGuard on %h</name>
  <service>
    <type>_hazardguard._tcp</type>
    <port>8088</port>
    <txt-record>path=/status</txt-record>
  </service>
</service-group>
