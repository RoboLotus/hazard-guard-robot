# Installed by scripts/install_services.sh; edit the template, not the copy in /etc.
[Unit]
Description=HazardGuard ROS 2 to MQTT bridge + system monitor
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Environment=ROS_DOMAIN_ID=@ROS_DOMAIN_ID@
ExecStart=/bin/bash -c '@SOURCE@ exec ros2 launch hazard_guard_iot iot_bridge.launch.py'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
