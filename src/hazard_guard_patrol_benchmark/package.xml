<?xml version="1.0"?>
<package format="3">
  <name>hazard_guard_patrol_benchmark</name>
  <version>0.1.0</version>
  <description>Gazebo-only patrol coverage and timing benchmark for HazardGuard.</description>
  <maintainer email="gw010101@naver.com">kohs2k21</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>hazard_guard_interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
