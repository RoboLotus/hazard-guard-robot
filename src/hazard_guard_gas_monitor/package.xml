<?xml version="1.0"?>
<package format="3">
  <name>hazard_guard_gas_monitor</name>
  <version>0.1.0</version>
  <description>Low-cost VOC, CO and CO2 sensing simulation and early-warning state machine.</description>
  <maintainer email="junbeom@dgu.ac.kr">beomaura</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>ament_index_python</depend>
  <depend>hazard_guard_interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
