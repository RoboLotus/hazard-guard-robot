Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 32; 36; 44
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 1
      Color: 90; 96; 108
      Alpha: 0.5
    - Class: rviz_default_plugins/RobotModel
      Name: ROSMASTER M1
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Frame Timeout: 15
      Marker Scale: 0.4
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Color: 255; 85; 85
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: RTAB-Map 3D Cloud
      Enabled: true
      Topic:
        Value: /hazard_guard/rtabmap/cloud_surface
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 2
      Size (m): 0.015
      Position Transformer: XYZ
      Color Transformer: RGB8
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: true
      Alpha: 1
      Decay Time: 0
    - Class: rviz_default_plugins/Map
      Name: RTAB-Map 2D Projection
      Enabled: true
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Alpha: 0.55
      Color Scheme: map
    - Class: rtabmap_rviz_plugins/MapGraph
      Name: RTAB-Map Graph
      Enabled: true
      Topic:
        Value: /rtabmap/mapGraph
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Neighbor: 75; 120; 255
      Global loop closure: 255; 80; 80
      Local loop closure: 255; 220; 80
      Landmark: 80; 220; 120
      Virtual: 220; 100; 255
      User: 255; 255; 255
    - Class: rviz_default_plugins/Image
      Name: RGB Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Depth Camera
      Enabled: true
      Topic:
        Value: /depth_camera/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Normalize Range: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: 3D Mapping View
      Distance: 7
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Pitch: 0.65
      Yaw: 0.75
Window Geometry:
  Height: 900
  Width: 1500
