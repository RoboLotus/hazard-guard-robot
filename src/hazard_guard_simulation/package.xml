<?xml version="1.0"?>
<package format="3">
  <name>hazard_guard_simulation</name>
  <version>0.1.0</version>
  <description>Hardware-free Gazebo Fortress simulation for the Yahboom ROSMASTER M1 HazardGuard robot.</description>
  <maintainer email="gw010101@naver.com">kohs2k21</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ignition-gazebo6</depend>
  <depend>ignition-plugin1</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>hazard_guard_person_detection</exec_depend>
  <exec_depend>hazard_guard_sensor_config</exec_depend>
  <exec_depend>hazard_guard_safety_supervisor</exec_depend>
  <exec_depend>hazard_guard_thermal_analysis</exec_depend>
  <exec_depend>hazard_guard_mission_manager</exec_depend>
  <exec_depend>hazard_guard_mock_robot</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <!-- camera_view.launch.py only; the simulation itself does not need rqt -->
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>rtabmap_rviz_plugins</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_sync</exec_depend>
  <exec_depend>rtabmap_util</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
