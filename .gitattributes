* text=auto

# Windows에서 clone해도 WSL/Docker 실행 파일은 LF를 유지한다.
*.py text eol=lf
*.sh text eol=lf
CMakeLists.txt text eol=lf
package.xml text eol=lf
LICENSE text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.cfg text eol=lf
*.msg text eol=lf
*.srv text eol=lf
*.xml text eol=lf
*.xacro text eol=lf
*.sdf text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.gitkeep text eol=lf
src/**/resource/* text eol=lf

# 시뮬레이션 및 지도 바이너리 자산
*.stl binary
*.pgm binary
*.png binary
*.jpg binary
*.jpeg binary
