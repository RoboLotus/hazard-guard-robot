# ROS / colcon outputs
build/
install/
log/
*.log
.ros/
compile_commands.json

# Python and test caches
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
.venv/
venv/

# Runtime-generated maps, recordings and local debug helpers
runtime/maps/*
runtime/debug/
!runtime/maps/.gitkeep
runtime/settings/
runtime/bags/
runtime/benchmarks/
# Captured calibration frames - tens of megabytes each. The JSON results beside
# them are kept on purpose so runs can be compared.
runtime/calibration/*.npz
*.db3
*.mcap

# Local manufacturer assets and share bundles
Yahboom/
vendor-assets/
share/
*.glb
*.gltf
*.usdz

# Local orchestration, harness, and agent files
AGENTS.md
AGENTS.override.md
.codex/
.harness/
docs/
PLANS.md
PROJECT_QUESTIONNAIRE.md

# Editors and OS metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Native build artifacts
*.o
*.a
*.so
